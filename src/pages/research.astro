---
import Base from '../layouts/Base.astro';
import research from '../data/research.json';
import profile from '../data/profile.json';
---

<Base title="Research" description="Research interests of George Dimopoulos: X-ray views of supermassive black holes.">
  <section class="section">
    <div class="container">
      <span class="kicker">Research</span>
      <h1>What I work on</h1>
      <p class="intro muted">{research.intro}</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="topic-grid">
        {research.topics.map((topic) => (
          <div class="card reveal">
            <span class="card-icon" aria-hidden="true">{topic.icon}</span>
            <h3>{topic.title}</h3>
            <p>{topic.text}</p>
          </div>
        ))}
      </div>
      <p class="reveal" style="margin-top: 2rem;">
        Curious about the details? Have a look at my
        <a href="/cv#publications">publications</a> or find me on
        <a href={profile.social.ads} rel="noopener">NASA ADS</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 62ch; font-size: 1.1rem; }

  .topic-grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
</style>
