---
import Base from '../layouts/Base.astro';
import cv from '../data/cv.json';
import publications from '../data/publications.json';
import profile from '../data/profile.json';
---

<Base title="CV & Publications" description="Curriculum vitae and publications of George Dimopoulos.">
  <section class="section">
    <div class="container">
      <span class="kicker">Curriculum vitae</span>
      <h1>CV & Publications</h1>
      {cv.cvPdf ? (
        <a class="btn btn-primary" href={cv.cvPdf} download>Download CV (PDF)</a>
      ) : (
        <p class="muted">A downloadable PDF version is coming soon.</p>
      )}
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container cv-grid">
      <div class="reveal">
        <h2>Positions</h2>
        <ul class="timeline">
          {cv.positions.map((item) => (
            <li>
              <span class="when">{item.when}</span>
              <h3>{item.title}</h3>
              <p class="where">{item.where}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <h2>Education</h2>
        <ul class="timeline">
          {cv.education.map((item) => (
            <li>
              <span class="when">{item.when}</span>
              <h3>{item.title}</h3>
              <p class="where">{item.where}</p>
              {'note' in item && item.note && <p class="muted note">{item.note}</p>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="publications" style="background: var(--bg-soft);">
    <div class="container">
      <span class="kicker reveal">Publications</span>
      <h2 class="reveal">Selected publications</h2>
      <ul class="pub-list">
        {publications.map((pub) => (
          <li class="reveal">
            <p class="pub-title">{pub.title}</p>
            <p class="pub-meta">
              {pub.authors} · <span class="journal">{pub.journal}</span> · {pub.year}
            </p>
            {(pub.link || pub.arxiv) && (
              <p class="pub-links">
                {pub.link && <a href={pub.link} rel="noopener">Journal</a>}
                {pub.arxiv && <a href={pub.arxiv} rel="noopener">arXiv</a>}
              </p>
            )}
          </li>
        ))}
      </ul>
      <p class="reveal">
        Full and up-to-date list on <a href={profile.social.ads} rel="noopener">NASA ADS</a> ·
        ORCID iD: <a href={profile.social.orcid} rel="noopener" class="orcid-link">
          <svg viewBox="0 0 256 256" width="16" height="16" aria-hidden="true"><path fill="#A6CE39" d="M256 128c0 70.7-57.3 128-128 128S0 198.7 0 128 57.3 0 128 0s128 57.3 128 128z"/><path fill="#fff" d="M86.3 186.2H70.9V79.1h15.4v107.1zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.4zM88.7 56.8c0 5.5-4.5 10.1-10.1 10.1s-10.1-4.6-10.1-10.1c0-5.6 4.5-10.1 10.1-10.1s10.1 4.6 10.1 10.1z"/></svg>
          0009-0002-4945-5121</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .cv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .note { font-size: 0.9rem; margin-top: 0.3rem; }

  .orcid-link { display: inline-flex; align-items: center; gap: 0.3rem; vertical-align: middle; }

  @media (max-width: 760px) {
    .cv-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
