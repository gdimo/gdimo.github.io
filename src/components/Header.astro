---
import data from '../data/models.json';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/cv', label: 'CV & Publications' },
  {
    href: '/models',
    label: 'Models',
    children: [
      { href: '/models', label: 'All models' },
      ...data.models.map((model) => ({
        href: `/models/${model.id}`,
        label: model.name,
      })),
    ],
  },
  { href: '/photography', label: 'Photography' },
  { href: '/podcast', label: 'Podcast' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const inSection = (href: string) => href !== '/' && current.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">G. Dimopoulos</a>
    <nav aria-label="Main">
      <button class="menu-btn" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-list">
        {nav.map((item) =>
          item.children ? (
            <li class="has-dropdown">
              <button
                class="nav-trigger"
                type="button"
                aria-expanded="false"
                aria-current={inSection(item.href) ? 'page' : undefined}
              >
                {item.label}
                <svg width="10" height="10" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2 4.5L6 8.5L10 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <ul class="dropdown">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={current === child.href ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={current === (item.href === '/' ? '/' : item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        )}
        <li>
          <button class="theme-toggle" aria-label="Toggle color theme" title="Toggle theme">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.5" />
              <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" />
            </svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.6rem;
  }

  .brand {
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    font-size: 1.05rem;
  }

  .brand:hover { text-decoration: none; color: var(--accent); }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    display: block;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 550;
    font-size: 0.95rem;
  }

  .nav-list a:hover {
    text-decoration: none;
    color: var(--text);
    background: var(--accent-soft);
  }

  .nav-list a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* ---- Dropdown ---- */
  .has-dropdown { position: relative; }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.75rem;
    border: none;
    border-radius: 999px;
    background: none;
    font: inherit;
    font-weight: 550;
    font-size: 0.95rem;
    color: var(--muted);
    cursor: pointer;
  }

  .nav-trigger:hover,
  .nav-trigger[aria-expanded='true'] {
    color: var(--text);
    background: var(--accent-soft);
  }

  .nav-trigger[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .nav-trigger svg { transition: transform 0.18s ease; }
  .nav-trigger[aria-expanded='true'] svg { transform: rotate(180deg); }

  .dropdown {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    min-width: 190px;
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-lift);
    display: none;
    z-index: 60;
  }

  .dropdown.open { display: block; }

  .dropdown a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    white-space: nowrap;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin-left: 0.35rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text);
    cursor: pointer;
  }

  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }

  :global([data-theme='dark']) .icon-moon { display: none; }
  :global([data-theme='light']) .icon-sun { display: none; }

  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-elev);
    cursor: pointer;
    padding: 0.55rem;
  }

  .menu-btn span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 760px) {
    .menu-btn { display: flex; }

    nav { position: relative; }

    .nav-list {
      position: absolute;
      right: 0;
      top: calc(100% + 0.6rem);
      flex-direction: column;
      align-items: stretch;
      min-width: 220px;
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 0.5rem;
      box-shadow: var(--shadow-lift);
      display: none;
    }

    .nav-list.open { display: flex; }

    .nav-list a { border-radius: 10px; padding: 0.6rem 0.9rem; }

    /* Inside the hamburger menu the submenu is a plain indented list. */
    .nav-trigger { width: 100%; justify-content: space-between; padding: 0.6rem 0.9rem; }

    .dropdown {
      position: static;
      display: block;
      min-width: 0;
      margin: 0 0 0.2rem 0.6rem;
      padding: 0;
      border: none;
      border-inline-start: 1px solid var(--border);
      border-radius: 0;
      box-shadow: none;
      background: none;
    }

    .dropdown a { font-size: 0.92rem; padding-block: 0.45rem; }

    .theme-toggle { margin: 0.3rem 0 0 0.35rem; }
  }
</style>

<script>
  const btn = document.querySelector('.menu-btn');
  const list = document.querySelector('.nav-list');
  btn?.addEventListener('click', () => {
    const open = list?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(Boolean(open)));
  });

  // Dropdown menus: click to open, close on outside click or Escape.
  // On mobile the submenu is always shown inline, so the trigger is inert there.
  const isMobile = () => window.matchMedia('(max-width: 760px)').matches;

  document.querySelectorAll<HTMLButtonElement>('.nav-trigger').forEach((trigger) => {
    const menu = trigger.nextElementSibling as HTMLElement | null;
    if (!menu) return;

    trigger.addEventListener('click', (event) => {
      if (isMobile()) return;
      event.stopPropagation();
      const open = menu.classList.toggle('open');
      trigger.setAttribute('aria-expanded', String(open));
    });

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });

  const closeDropdowns = () => {
    document.querySelectorAll('.dropdown.open').forEach((menu) => menu.classList.remove('open'));
    document
      .querySelectorAll('.nav-trigger[aria-expanded="true"]')
      .forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
  };

  document.addEventListener('click', closeDropdowns);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDropdowns();
  });

  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
