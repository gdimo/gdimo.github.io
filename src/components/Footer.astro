---
import profile from '../data/profile.json';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="muted">© {year} {profile.name}</p>
    <ul class="footer-links">
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      <li><a href={profile.social.github} rel="noopener">GitHub</a></li>
      <li><a href={profile.social.orcid} rel="noopener">ORCID</a></li>
      <li><a href={profile.social.linkedin} rel="noopener">LinkedIn</a></li>
      <li><a href={profile.social.podcast} rel="noopener">Podcast</a></li>
      <li><a href={profile.social.ads} rel="noopener">ADS</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 3rem;
    background: var(--bg-soft);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.6rem;
  }

  .footer-inner p { margin: 0; font-size: 0.92rem; }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
  }
</style>
